/** NovaOrb chat Worker configuration. Replace the D1 database_id placeholder before deployment. */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novaorb-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novaorb",
      "database_id": "PUT_THE_SHARED_NOVAORB_D1_DATABASE_ID_HERE"
    }
  ],
  "upload_source_maps": true
}
